<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Beamline</vendor>
  <action id="org.beamline.extensions.enable">
    <annotate key="org.freedesktop.policykit.owner">unix-user:beamline-ctl</annotate>
    <description>Enable a system extension</description>
    <message>Authentication is required to enable a system extension</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="org.beamline.extensions.disable">
    <annotate key="org.freedesktop.policykit.owner">unix-user:beamline-ctl</annotate>
    <description>Disable a system extension</description>
    <message>Authentication is required to disable a system extension</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="org.beamline.extensions.activate">
    <annotate key="org.freedesktop.policykit.owner">unix-user:beamline-ctl</annotate>
    <description>Activate a system extension</description>
    <message>Authentication is required to activate a system extension</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="org.beamline.extensions.deactivate">
    <annotate key="org.freedesktop.policykit.owner">unix-user:beamline-ctl</annotate>
    <description>Deactivate a system extension</description>
    <message>Authentication is required to deactivate a system extension</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
</policyconfig>
