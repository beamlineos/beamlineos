polkit.addAdminRule(function(action, subject) {
    return ["unix-group:wheel"];
});


polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" && subject.user == "beamline-ctl") {
        var units = ["beamline-extensions-refresh.service", "beamline-extension@desktop-gnome.service",
                     "beamline-extension@posix.service", "beamline-extension@posix-devel.service",
                     "beamline-extension@printing-scanning.service", "beamline-extension-unlink@posix.service",
                     "beamline-extension-unlink@posix-devel.service", "beamline-extension-unlink@printing-scanning.service"];
        var verbs = ["start", "stop", "restart"];
        return units.indexOf(action.lookup("unit")) >= 0 && verbs.indexOf(action.lookup("verb")) >= 0
            ? polkit.Result.YES : polkit.Result.NO;
    }
});





polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" ||
        action.id.indexOf("org.freedesktop.sysupdate1.") == 0 ||
        action.id.indexOf("org.beamline.") == 0) {
        return subject.isInGroup("wheel") ? polkit.Result.AUTH_ADMIN_KEEP : polkit.Result.NO;
    }
});
