# SPDX-License-Identifier: MIT
#
# initrd only (docs/spec.md §14, docs/decisions.md D56): rebuild /etc's mutable layer from the
# allowlist alone, before it is merged. DATA is not verity-protected: a file put into the layer
# by an offline edit of the disk, or written during a permissive development boot, must not
# become part of /etc. Each allowlisted file is copied aside, the layer is removed and
# recreated, and the allowlisted files are copied back; anything else is gone. Copies carry no
# SELinux label (the initrd has no policy); the host relabels them by path (10-data-labels.conf).
# The layer's root is the merged /etc's root, so it gets /etc's label (etc_t) here, while no
# policy is loaded and root may set any label: systemd-confext does not relabel it when no
# extension is merged, and an unlabelled /etc would be unreadable to confined domains
# (docs/decisions.md D58).

[Unit]
Description=Keep only allowlisted files in /etc's mutable layer
DefaultDependencies=no
ConditionPathExists=/etc/initrd-release
Requires=sysroot-var.mount
After=sysroot-var.mount
Before=systemd-confext-sysroot.service initrd-switch-root.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=LAYER=/sysroot/var/lib/extensions.mutable/etc KEEP=/run/beamline/etc-allowlist
ExecStart=/usr/bin/systemd-tmpfiles --create --inline "d ${KEEP} 0700 root root -" \
    "C- ${KEEP}/hostname - - - - ${LAYER}/hostname" \
    "C- ${KEEP}/machine-info - - - - ${LAYER}/machine-info" \
    "C- ${KEEP}/machine-id - - - - ${LAYER}/machine-id" \
    "C- ${KEEP}/localtime - - - - ${LAYER}/localtime" \
    "C- ${KEEP}/adjtime - - - - ${LAYER}/adjtime" \
    "C- ${KEEP}/locale.conf - - - - ${LAYER}/locale.conf" \
    "C- ${KEEP}/vconsole.conf - - - - ${LAYER}/vconsole.conf"
ExecStart=/usr/bin/systemd-tmpfiles --remove --inline "R ${LAYER}"
ExecStart=/usr/bin/systemd-tmpfiles --create --inline "d ${LAYER} 0755 root root -" \
    "t ${LAYER} - - - - security.selinux=system_u:object_r:etc_t:s0" \
    "C- ${LAYER}/hostname - - - - ${KEEP}/hostname" \
    "C- ${LAYER}/machine-info - - - - ${KEEP}/machine-info" \
    "C- ${LAYER}/machine-id - - - - ${KEEP}/machine-id" \
    "C- ${LAYER}/localtime - - - - ${KEEP}/localtime" \
    "C- ${LAYER}/adjtime - - - - ${KEEP}/adjtime" \
    "C- ${LAYER}/locale.conf - - - - ${KEEP}/locale.conf" \
    "C- ${LAYER}/vconsole.conf - - - - ${KEEP}/vconsole.conf"
ExecStart=/usr/bin/systemd-tmpfiles --remove --inline "R ${KEEP}"
