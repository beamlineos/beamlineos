[Unit]
Description=/var on DATA, for the root
DefaultDependencies=no
ConditionPathExists=/etc/initrd-release
Requires=sysroot-data.mount
After=sysroot-data.mount
Before=initrd-switch-root.target

[Mount]
What=/sysroot/data/var
Where=/sysroot/var
Type=none
Options=bind
