# A stop of an already inactive instance does not run ExecStop again. Retry cleanup explicitly.
[Unit]
Description=Remove the %i extension image links
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-tmpfiles --remove --inline "r /run/extensions/%i.raw" "r /run/confexts/%i.raw"
