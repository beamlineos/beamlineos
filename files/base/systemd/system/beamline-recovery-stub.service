[Unit]
Description=Beamline RecoveryOS is a stub: nothing to recover with yet, powering off
ConditionPathExists=/etc/initrd-release

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-escape BEAMLINE_RECOVERY_STUB
StandardOutput=journal+console
SuccessAction=poweroff
