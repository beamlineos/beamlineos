[Unit]
Description=Link the %i extension of this snapshot
DefaultDependencies=no
Requires=beamline-extension-state.service
After=local-fs.target beamline-extension-state.service
Before=systemd-sysext.service systemd-confext.service sysinit.target
ConditionPathExists=/var/lib/beamline/extensions/%i_%A.raw
ConditionPathExists=/var/lib/beamline/confexts/%i_%A.raw
ConditionPathExists=|/run/beamline/boot-state/%i.enabled
ConditionPathExists=|/run/beamline/active/%i
ConditionPathExists=!/run/beamline/inactive/%i

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemd-tmpfiles --create --inline "L /run/extensions/%i.raw - - - - /var/lib/beamline/extensions/%i_%A.raw" "L /run/confexts/%i.raw - - - - /var/lib/beamline/confexts/%i_%A.raw"
ExecStop=/usr/bin/systemd-tmpfiles --remove --inline "r /run/extensions/%i.raw" "r /run/confexts/%i.raw"


ExecStopPost=/usr/bin/systemd-tmpfiles --remove --inline "r /run/extensions/%i.raw" "r /run/confexts/%i.raw"

[Install]
WantedBy=sysinit.target
