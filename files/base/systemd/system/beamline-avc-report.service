[Unit]
Description=Report SELinux AVC denials on the console
ConditionSecurity=selinux
After=multi-user.target beamline-selinux-ok.service
Before=beamline-boot-ok.service

[Service]
Type=oneshot
RuntimeDirectory=beamline-avc
RuntimeDirectoryPreserve=yes
ExecStart=-/usr/bin/journalctl --boot --no-pager --output=cat --grep=avc: --cursor-file=/run/beamline-avc/cursor

StandardOutput=tty

[Install]
WantedBy=multi-user.target
