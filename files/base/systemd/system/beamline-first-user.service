[Unit]
Description=Create the First User Account
Documentation=man:homectl(1)
ConditionFirstBoot=yes
After=home.mount systemd-homed.service systemd-homed-firstboot.service

Before=systemd-user-sessions.service first-boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/homectl firstboot --prompt-new-user --prompt-shell=no --prompt-groups=no --member-of=wheel --disk-size=50%% --rebalance-weight=20 --mute-console=no
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYReset=yes

[Install]
WantedBy=systemd-homed.service
