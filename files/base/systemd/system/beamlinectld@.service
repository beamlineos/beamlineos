# SPDX-License-Identifier: MIT
[Unit]
Description=Beamline extension control connection
CollectMode=inactive-or-failed
ConditionPathExists=!/etc/initrd-release

[Service]
ExecStart=/usr/libexec/beamlinectld
User=beamline-ctl
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
StateDirectory=beamline/state
StateDirectoryMode=0755
ReadWritePaths=/run/beamline/active /run/beamline/inactive
ProtectKernelTunables=yes
# Module-directory bind mounts pin the old /usr across a sysext refresh (D118).
# Keep module operations forbidden without masking paths inside that hierarchy.
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
IPAddressDeny=any
SystemCallFilter=@system-service
SystemCallFilter=~@module
SystemCallArchitectures=native
UMask=0022
RuntimeMaxSec=600
