[Unit]
Description=Start units brought by merged extensions
DefaultDependencies=no
After=systemd-sysext.service systemd-confext.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/systemd-tmpfiles --create --inline "f /run/beamline/boot-complete 0444 root root -"
ExecStart=/usr/bin/systemctl start --no-block default.target

[Install]
WantedBy=sysinit.target
