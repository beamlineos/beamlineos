# SPDX-License-Identifier: MIT










[Transfer]
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=https://updates.beamline.invalid/channels/latest/
MatchPattern=beamline_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=beamline_@v+@l-@d.efi \
             beamline_@v+@l.efi \
             beamline_@v.efi

Mode=0644
TriesLeft=3
TriesDone=0
InstancesMax=2
