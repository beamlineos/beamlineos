# SPDX-License-Identifier: MIT




[Transfer]
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=https://updates.beamline.invalid/channels/latest/
MatchPattern=posix-devel_@v.confext.raw

[Target]
Type=regular-file
Path=/var/lib/beamline/confexts
MatchPattern=posix-devel_@v.raw
Mode=0444
InstancesMax=2
