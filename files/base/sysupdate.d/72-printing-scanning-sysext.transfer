# SPDX-License-Identifier: MIT




[Transfer]
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=https://updates.beamline.invalid/channels/latest/
MatchPattern=printing-scanning_@v.sysext.raw

[Target]
Type=regular-file
Path=/var/lib/beamline/extensions
MatchPattern=printing-scanning_@v.raw
Mode=0444
InstancesMax=2
