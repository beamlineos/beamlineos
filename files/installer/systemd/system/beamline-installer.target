# SPDX-License-Identifier: MIT
#
# The installer medium's live system (0.0.4.3, docs/decisions.md D106, D113), shipped by the
# installer extension. The installer UKI starts this target instead of multi-user: no homes, no
# network, no other extensions, only the console's installer and the SELinux reports every boot
# prints.

[Unit]
Description=Beamline Installer
Documentation=man:systemd-sysinstall(8)
Requires=basic.target
After=basic.target
Wants=beamline-installer.service beamline-selinux-ok.service
Wants=beamline-avc-report.service beamline-avc-follow.service
AllowIsolate=yes
