[Unit]
Description=Install Beamline
Documentation=man:systemd-sysinstall(8)
Wants=systemd-logind.service
After=systemd-logind.service beamline-selinux-ok.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemd-sysinstall --boot-loader=no --variables=no --reboot=yes --mute-console=no --kernel=/boot/beamline/uki/beamline_%A.efi
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes
FailureAction=halt
