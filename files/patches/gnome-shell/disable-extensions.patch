diff --git a/js/ui/extensionDownloaderDisabled.js b/js/ui/extensionDownloaderDisabled.js
new file mode 100644
--- /dev/null
+++ b/js/ui/extensionDownloaderDisabled.js
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// No downloader, installer, updates or user directory access in this build.
+import {ExtensionErrors, ExtensionError} from '../misc/dbusErrors.js';
+
+export function init() {
+}
+
+export function installExtension(uuid, invocation) {
+    invocation.return_error_literal(
+        ExtensionErrors, ExtensionError.NOT_ALLOWED,
+        'Shell extension support is disabled in this build');
+}
+
+export function uninstallExtension() {
+    return false;
+}
+
+export function checkForUpdates() {
+}
diff --git a/js/ui/extensionSystemDisabled.js b/js/ui/extensionSystemDisabled.js
new file mode 100644
--- /dev/null
+++ b/js/ui/extensionSystemDisabled.js
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// The extension loader is absent from builds configured with -Dextensions=false.
+// Keep the public Shell API available to clients without inspecting any extension files.
+import * as Signals from '../misc/signals.js';
+
+export class ExtensionManager extends Signals.EventEmitter {
+    init() {
+    }
+
+    get updatesSupported() {
+        return false;
+    }
+
+    lookup() {
+        return undefined;
+    }
+
+    getUuids() {
+        return [];
+    }
+
+    enableExtension() {
+        return false;
+    }
+
+    disableExtension() {
+        return false;
+    }
+
+    openExtensionPrefs() {
+        throw new Error('Shell extension support is disabled in this build');
+    }
+}
diff --git a/js/ui/shellDBus.js b/js/ui/shellDBus.js
--- a/js/ui/shellDBus.js
+++ b/js/ui/shellDBus.js
@@ -498,10 +498,13 @@
     }
 
     get UserExtensionsEnabled() {
-        return !global.settings.get_boolean('disable-user-extensions');
+        return Config.HAVE_EXTENSIONS &&
+            !global.settings.get_boolean('disable-user-extensions');
     }
 
     set UserExtensionsEnabled(enable) {
+        if (!Config.HAVE_EXTENSIONS)
+            return;
         global.settings.set_boolean('disable-user-extensions', !enable);
     }
 
