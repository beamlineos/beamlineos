         return free_and_strdup(ret_context, context);
 }
 
+/* A manager loads a unit file, fragment or drop-in, only if the policy lets it: it asks for the
+ * "load" permission of the "service" class, its own context against the file's. The context is the
+ * file's after following symlinks, so a link from a unit directory to a writable location is judged
+ * by the file it points to. Pass the context when the caller already read it from the opened file. */
+int mac_selinux_unit_file_load_check(const char *path, const char *file_context) {
+        _cleanup_freecon_ char *scon = NULL, *fcon = NULL;
+        int r;
+
+        assert(path);
+
+        r = access_init(/* reterr_error= */ NULL);
+        if (r <= 0)
+                return r;
+
+        if (sym_getcon_raw(&scon) < 0)
+                return log_selinux_enforcing_errno(errno, "SELinux getcon_raw() failed: %m");
+
+        if (!file_context) {
+                if (sym_getfilecon_raw(path, &fcon) < 0)
+                        return log_selinux_enforcing_errno(errno, "Failed to read SELinux context of '%s': %m", path);
+                file_context = fcon;
+        }
+
+        struct audit_info audit_info = {
+                .path = path,
+                .function = __func__,
+        };
+
+        return check_access(scon, file_context, "service", "load", &audit_info, /* reterr_error= */ NULL);
+}
+
 /*
