    allow the access.
@@ -468,6 +499,10 @@ int mac_selinux_transient_context_varlink(sd_varlink *link, char **ret_context)
         return 0;
 }
 
+int mac_selinux_unit_file_load_check(const char *path, const char *file_context) {
+        return 0;
+}
