+/* Transient-unit contexts come from authenticated bus credentials, never racy /proc data. */
+int mac_selinux_transient_context(sd_bus_message *message, char **ret_context, sd_bus_error *reterr_error) {
+        _cleanup_(sd_bus_creds_unrefp) sd_bus_creds *creds = NULL;
+        const char *context;
+        int r;
+
+        if (!mac_selinux_use())
+                return 0;
+        r = access_init(reterr_error);
+        if (r < 0)
+                return r;
+        if (r == 0)
+                return sd_bus_error_setf(reterr_error, SD_BUS_ERROR_ACCESS_DENIED,
+                                         "Cannot initialize mandatory transient SELinux context bound");
+        r = sd_bus_query_sender_creds(message, SD_BUS_CREDS_SELINUX_CONTEXT, &creds);
+        if (r < 0)
+                return r;
+        if (sd_bus_creds_get_augmented_mask(creds) & SD_BUS_CREDS_SELINUX_CONTEXT)
+                return sd_bus_error_setf(reterr_error, SD_BUS_ERROR_ACCESS_DENIED, "Unauthenticated SELinux context");
+        r = sd_bus_creds_get_selinux_context(creds, &context);
+        if (r < 0)
+                return r;
+        if (isempty(context))
+                return sd_bus_error_setf(reterr_error, SD_BUS_ERROR_ACCESS_DENIED, "Missing SELinux context");
+        return free_and_strdup(ret_context, context);
+}
+
+int mac_selinux_transient_transition(sd_bus_message *message, const char *bound, const char *target, sd_bus_error *reterr_error) {
+        _cleanup_free_ char *caller = NULL;
+        int r;
+
+        r = mac_selinux_transient_context(message, &caller, reterr_error);
+        if (r < 0 || !caller)
+                return r;
+
+        struct audit_info audit_info = { .function = __func__ };
+        r = check_access(caller, target, "process", "transition", &audit_info, reterr_error);
+        if (r < 0)
+                return r;
+        /* A later caller cannot raise the unit above the original creator either. */
+        if (bound && !streq(bound, caller))
+                return check_access(bound, target, "process", "transition", &audit_info, reterr_error);
+        return 0;
+}
+
+/* The varlink equivalent of mac_selinux_transient_context(): the peer's authenticated context
+ * from SO_PEERSEC, bound before properties so a default-context unit cannot inherit PID 1's. */
+int mac_selinux_transient_context_varlink(sd_varlink *link, char **ret_context) {
+        _cleanup_freecon_ char *context = NULL;
+        int fd, r;
+
+        assert(link);
+        assert(ret_context);
+
+        if (!mac_selinux_use())
+                return 0;
+        r = access_init(/* reterr_error= */ NULL);
+        if (r < 0)
+                return r;
+        if (r == 0)
+                return -EACCES;
+        fd = sd_varlink_get_fd(link);
+        if (fd < 0)
+                return fd;
+        if (sym_getpeercon_raw(fd, &context) < 0)
+                return -errno;
+        if (isempty(context))
+                return -EACCES;
+        return free_and_strdup(ret_context, context);
+}
