#
# gnome-build-meta's GDM greeter stack (core/gdm.bst) with pam_selinux added (docs/security.md §16,
# docs/decisions.md D96). The greeter session runs in user_t like every session; without
# pam_selinux its session leader stayed in the domain of GDM's worker.

auth       required    pam_env.so
auth       required    pam_permit.so
auth       include     postlogin
account    required    pam_permit.so
password   required    pam_permit.so
session    required    pam_selinux.so close
session    required    pam_selinux.so open
session    optional    pam_keyinit.so force revoke
session    include     system-auth
session    include     postlogin
