(context sys (system_u object_r default_t lr_platform))

(filecon "/" dir (system_u object_r root_t lr_platform))
(filecon "/.*" any sys)

                       
(filecon "/usr(/.*)?" any (system_u object_r usr_t lr_platform))
(filecon "/usr/s?bin(/.*)?" any (system_u object_r bin_t lr_platform))
(filecon "/usr/libexec(/.*)?" any (system_u object_r bin_t lr_platform))
(filecon "/usr/lib/systemd/systemd" file (system_u object_r init_exec_t lr_platform))
(filecon "/usr/lib/systemd/systemd-(executor|shutdown)" file (system_u object_r init_exec_t lr_platform))
                                                                               
(filecon "/usr/lib/systemd/systemd-hostnamed" file (system_u object_r hostnamed_exec_t lr_platform))
(filecon "/usr/lib/systemd/systemd-timedated" file (system_u object_r timedated_exec_t lr_platform))
(filecon "/usr/lib/systemd/systemd-localed" file (system_u object_r localed_exec_t lr_platform))
(filecon "/usr/lib/systemd/systemd-sysupdated?" file (system_u object_r sysupdate_exec_t lr_platform))
(filecon "/usr/lib/systemd/systemd-home(d|work)" file (system_u object_r homed_exec_t lr_platform))
(filecon "/usr/bin/systemd-(sysext|confext)" any (system_u object_r sysext_exec_t lr_platform))
(filecon "/etc(/.*)?" any (system_u object_r etc_t lr_platform))
                                                                                             
(filecon "/etc" dir (system_u object_r etc_t lr_admin))
(filecon "/var/lib/extensions.mutable/etc" dir (system_u object_r etc_t lr_admin))
                                                                                     
(filecon "/usr/lib/systemd/user(/.*)?" any (system_u object_r user_unit_file_t lr_platform))
(filecon "/usr/lib/systemd/system/user@\.service" file (system_u object_r user_manager_unit_t lr_platform))
(filecon "/etc/systemd/user(/.*)?" any (system_u object_r user_unit_file_t lr_platform))
(filecon "/etc/g?shadow" file (system_u object_r shadow_t lr_platform))
(filecon "/etc/selinux(/.*)?" any (system_u object_r selinux_config_t lr_platform))
                                                                                 
(filecon "/etc/hostname" any (system_u object_r hostname_etc_t lr_admin))
(filecon "/etc/machine-info" any (system_u object_r hostname_etc_t lr_admin))
(filecon "/etc/localtime" any (system_u object_r timezone_etc_t lr_admin))
(filecon "/etc/adjtime" any (system_u object_r timezone_etc_t lr_admin))
(filecon "/etc/locale.conf" any (system_u object_r locale_etc_t lr_admin))
(filecon "/etc/vconsole.conf" any (system_u object_r locale_etc_t lr_admin))
(filecon "/etc/machine-id" any (system_u object_r machine_id_etc_t lr_admin))
                                                                         
(filecon "/etc/.pwd.lock" file (system_u object_r etc_runtime_t lr_platform))
(filecon "/etc/.updated" file (system_u object_r etc_runtime_t lr_platform))
(filecon "/efi(/.*)?" any (system_u object_r boot_t lr_platform))

                                                           
(filecon "/data(/.*)?" any (system_u object_r data_t lr_platform))
(filecon "/data/var(/.*)?" any (system_u object_r var_t lr_platform))
(filecon "/data/var/log(/.*)?" any (system_u object_r var_log_t lr_platform))
(filecon "/data/var/lib(/.*)?" any (system_u object_r var_lib_t lr_platform))
(filecon "/data/var/tmp(/.*)?" any (system_u object_r tmp_t lr_low))
(filecon "/data/home" dir (system_u object_r home_root_t lr_platform))
(filecon "/var(/.*)?" any (system_u object_r var_t lr_platform))
(filecon "/var/log(/.*)?" any (system_u object_r var_log_t lr_platform))
(filecon "/var/lib(/.*)?" any (system_u object_r var_lib_t lr_platform))
(filecon "/var/lib/gdm(/.*)?" any (system_u object_r xdm_var_lib_t lr_session))
(filecon "/var/tmp(/.*)?" any (system_u object_r tmp_t lr_low))
                                                                                          
                                           
(filecon "/var/lib/extensions.mutable/etc/hostname" any (system_u object_r hostname_etc_t lr_admin))
(filecon "/var/lib/extensions.mutable/etc/machine-info" any (system_u object_r hostname_etc_t lr_admin))
(filecon "/var/lib/extensions.mutable/etc/localtime" any (system_u object_r timezone_etc_t lr_admin))
(filecon "/var/lib/extensions.mutable/etc/adjtime" any (system_u object_r timezone_etc_t lr_admin))
(filecon "/var/lib/extensions.mutable/etc/locale.conf" any (system_u object_r locale_etc_t lr_admin))
(filecon "/var/lib/extensions.mutable/etc/vconsole.conf" any (system_u object_r locale_etc_t lr_admin))
(filecon "/var/lib/extensions.mutable/etc/machine-id" any (system_u object_r machine_id_etc_t lr_admin))
(filecon "/home" dir (system_u object_r home_root_t lr_platform))
(filecon "/home/[^/]+" dir (system_u object_r user_home_dir_t lr_session))
(filecon "/home/[^/]+/.+" any (system_u object_r user_home_t lr_session))
                                                                           
(filecon "/home/[^/]+.home" file (system_u object_r data_t lr_platform))

                                                       
(filecon "/tmp(/.*)?" any (system_u object_r tmp_t lr_low))
(filecon "/run(/.*)?" any (system_u object_r run_t lr_platform))
                                                           
(filecon "/run/systemd/ask-password-block(/.*)?" any (system_u object_r run_t lr_admin))
(filecon "/run/user/[0-9]+(/.*)?" any (system_u object_r user_runtime_t lr_session))
(filecon "/run/gdm(/.*)?" any (system_u object_r xdm_runtime_t lr_session))
                                                       
(filecon "/run/systemd/system(/.*)?" any (system_u object_r init_unit_runtime_t lr_platform))
(filecon "/run/systemd/system\.control(/.*)?" any (system_u object_r init_unit_runtime_t lr_platform))
(filecon "/run/systemd/transient(/.*)?" any (system_u object_r init_unit_runtime_t lr_platform))
(filecon "/run/systemd/generator(\.early|\.late)?(/.*)?" any (system_u object_r generator_unit_t lr_platform))
(filecon "/usr/lib/systemd/system-generators/[^/]+" file (system_u object_r generator_exec_t lr_platform))
(filecon "/dev(/.*)?" any (system_u object_r device_t lr_low))
(filecon "/dev/null" char (system_u object_r null_device_t lr_low))
(filecon "/dev/shm(/.*)?" any (system_u object_r tmpfs_t lr_low))
(filecon "/sys/fs/cgroup(/.*)?" any (system_u object_r cgroup_t lr_platform))
