(context system_low (system_u object_r unlabeled_t lr_low))

                                                             
(sidcontext kernel (system_u system_r kernel_t lr_platform))
(sidcontext security (system_u object_r security_t lr_platform))
(sidcontext unlabeled system_low)
(sidcontext file system_low)
(sidcontext init (system_u system_r init_t lr_platform))
(sidcontext any_socket system_low)
(sidcontext port (system_u object_r port_t lr_low))
(sidcontext netif (system_u object_r netif_t lr_low))
(sidcontext netmsg system_low)
(sidcontext node (system_u object_r node_t lr_low))
(sidcontext devnull (system_u object_r null_device_t lr_low))

                                                                                 
                                                                                       
                                                                                           
(fsuse xattr erofs (system_u object_r system_fs_t lr_platform))
(fsuse xattr ext4 (system_u object_r data_fs_t lr_platform))
(fsuse xattr btrfs (system_u object_r data_fs_t lr_platform))
(fsuse xattr overlay (system_u object_r overlay_fs_t lr_platform))

                                                                   
(fsuse trans tmpfs (system_u object_r tmpfs_t lr_low))
(fsuse trans devtmpfs (system_u object_r device_t lr_low))
(fsuse trans devpts (system_u object_r devpts_t lr_low))
(fsuse trans mqueue (system_u object_r mqueue_t lr_low))
(fsuse task pipefs (system_u object_r fs_t lr_low))
(fsuse task sockfs (system_u object_r fs_t lr_low))

                                
(genfscon proc "/" (system_u object_r proc_t lr_platform))
(genfscon proc "/sys/user" (system_u object_r proc_sys_user_t lr_platform))
(genfscon proc "/sys/net" (system_u object_r proc_sys_net_t lr_platform))
(genfscon sysfs "/" (system_u object_r sysfs_t lr_platform))
