(genfscon cgroup2 "/" (system_u object_r cgroup_t lr_platform))
(genfscon efivarfs "/" (system_u object_r efivarfs_t lr_platform))
(genfscon bpf "/" (system_u object_r bpf_t lr_platform))
(genfscon debugfs "/" (system_u object_r debugfs_t lr_platform))
(genfscon tracefs "/" (system_u object_r tracefs_t lr_platform))
(genfscon pstore "/" (system_u object_r pstore_t lr_platform))
(genfscon configfs "/" (system_u object_r configfs_t lr_platform))
(genfscon fusectl "/" (system_u object_r fusefs_t lr_session))
(genfscon fuse "/" (system_u object_r fusefs_t lr_session))
(genfscon binfmt_misc "/" (system_u object_r binfmt_misc_t lr_platform))
(genfscon hugetlbfs "/" (system_u object_r hugetlbfs_t lr_platform))
(genfscon autofs "/" (system_u object_r autofs_t lr_platform))
(genfscon nsfs "/" (system_u object_r nsfs_t lr_platform))
(genfscon pidfs "/" (system_u object_r pidfs_t lr_platform))
