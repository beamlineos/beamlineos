(typeattribute beamline_mls_trusted_object)
(typeattributeset beamline_mls_trusted_object (security_t cgroup_t proc_sys_user_t))
                                                                                             
(typeattribute beamline_mls_signalled_by_session)
(typeattributeset beamline_mls_signalled_by_session (init_t))

                                                                                              

(mlsconstrain (file (write append create unlink link rename setattr relabelfrom relabelto))
    (or (dom l1 l2) (eq t2 beamline_mls_trusted_object)))
(mlsconstrain (lnk_file (write append create unlink link rename setattr relabelfrom relabelto))
    (or (dom l1 l2) (eq t2 beamline_mls_trusted_object)))
(mlsconstrain (chr_file (write append create unlink link rename setattr relabelfrom relabelto))
    (or (dom l1 l2) (eq t2 beamline_mls_trusted_object)))
(mlsconstrain (blk_file (write append create unlink link rename setattr relabelfrom relabelto))
    (or (dom l1 l2) (eq t2 beamline_mls_trusted_object)))
(mlsconstrain (dir (write append unlink link rename setattr relabelfrom relabelto add_name
    remove_name reparent rmdir))
    (or (dom l1 l2) (eq t2 beamline_mls_trusted_object)))
                                                                                              
                                                                                              
                                                                                                
                                                                                        
(mlsconstrain (dir (create))
    (or (dom l1 l2) (or (eq t2 beamline_mls_trusted_object)
        (and (eq t1 beamline_user_domain) (eq t2 beamline_user_namespace_type)))))
                                                                                           
(mlsconstrain (sock_file (create unlink link rename setattr relabelfrom relabelto))
    (or (dom l1 l2) (eq t2 beamline_mls_trusted_object)))
(mlsconstrain (fifo_file (create unlink link rename setattr relabelfrom relabelto))
    (or (dom l1 l2) (eq t2 beamline_mls_trusted_object)))
(mlsconstrain (shm (write destroy setattr)) (dom l1 l2))
(mlsconstrain (sem (write destroy setattr)) (dom l1 l2))
(mlsconstrain (msgq (write destroy setattr)) (dom l1 l2))
(mlsconstrain (msg (send)) (dom l1 l2))
(mlsconstrain (key (write setattr link create)) (dom l1 l2))
                                                                                           
(mlsconstrain (process (sigkill sigstop ptrace setsched setrlimit share setpgid)) (dom l1 l2))
(mlsconstrain (process (signal))
    (or (dom l1 l2) (eq t2 beamline_mls_signalled_by_session)))

                                                                                             

(mlsconstrain (file (execute execute_no_trans entrypoint execmod)) (dom l2 l1))

                                                                                               

(mlsconstrain (process (transition dyntransition setcurrent)) (dom l1 l2))
