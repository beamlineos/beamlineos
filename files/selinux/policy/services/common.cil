(allow beamline_confined_service self (process (fork sigchld sigkill sigstop signull signal
    getsched setsched getpgid setpgid getcap setcap getattr getsession setrlimit setfscreate
    setsockcreate setkeycreate)))
(allow beamline_confined_service self (fd (use)))
(allow beamline_confined_service self (fifo_file (all)))
(allow beamline_confined_service self (unix_dgram_socket (all)))
(allow beamline_confined_service self (unix_stream_socket (all)))
(allow beamline_confined_service self (anon_inode (all)))
(allow beamline_confined_service self (key (all)))
                                                                                          
(allow beamline_confined_service self (dir (getattr search read open)))
(allow beamline_confined_service self (file (getattr open read write ioctl)))
(allow beamline_confined_service self (lnk_file (getattr read)))

                                                              
(allow beamline_confined_service root_t (dir (getattr search read open)))
(allow beamline_confined_service beamline_immutable_file_type (dir (getattr search read open ioctl lock watch)))
(allow beamline_confined_service beamline_immutable_file_type (file (getattr read open map ioctl lock execute execute_no_trans watch)))
(allow beamline_confined_service beamline_immutable_file_type (lnk_file (getattr read)))
(allow beamline_confined_service beamline_etc_setting_type (file (getattr read open map)))
(allow beamline_confined_service beamline_etc_setting_type (lnk_file (getattr read)))

                                                                                                 
                                                                                              
                                           
(allow beamline_confined_service proc_t (dir (getattr search read open)))
(allow beamline_confined_service proc_t (file (getattr read open ioctl)))
(allow beamline_confined_service proc_t (lnk_file (getattr read)))
(allow beamline_confined_service sysfs_t (dir (getattr search read open)))
(allow beamline_confined_service sysfs_t (file (getattr read open ioctl)))
(allow beamline_confined_service sysfs_t (lnk_file (getattr read)))
(allow beamline_confined_service nsfs_t (file (getattr)))
(allow beamline_confined_service null_device_t (chr_file (getattr read write open ioctl append)))
(allow beamline_confined_service device_t (dir (getattr search)))
                                                                               
(allow beamline_confined_service device_t (lnk_file (getattr read)))
(allow beamline_confined_service var_t (dir (getattr search)))
(allow beamline_confined_service var_t (lnk_file (getattr read)))
                                                                         
(allow beamline_confined_service var_lib_t (dir (getattr search)))
(allow beamline_confined_service var_lib_t (lnk_file (getattr read)))
(allow beamline_confined_service run_t (dir (getattr search)))
                                                                              
(allow beamline_confined_service cgroup_t (dir (getattr search read open)))
(allow beamline_confined_service cgroup_t (file (getattr open read write)))

                                                                                                 
                                                                                          
                                  
(allow beamline_confined_service init_t (fd (use)))
(allow beamline_confined_service init_t (process (sigchld)))
(allow beamline_confined_service init_t (unix_dgram_socket (sendto)))
(allow beamline_confined_service init_t (unix_stream_socket (getattr getopt read write ioctl)))
(allow beamline_confined_service kernel_t (fd (use)))
(allow beamline_confined_service kernel_t (unix_dgram_socket (sendto)))
(allow beamline_confined_service kernel_t (unix_stream_socket (connectto)))
(allow beamline_confined_service run_t (sock_file (getattr write)))

                                                                                                  
                                                                              
(allow beamline_confined_service run_t (dir (read open)))
(allow beamline_confined_service run_t (lnk_file (getattr read)))
(allow beamline_confined_service run_t (sock_file (read)))
(allow beamline_confined_service init_t (unix_stream_socket (connectto)))
(allow beamline_confined_service platform_service_t (unix_stream_socket (connectto)))
(allow beamline_confined_service homed_t (unix_stream_socket (connectto)))

                                                                                            
                                                                                        
                                                                                    
(allow beamline_confined_service beamline_any_type (filesystem (getattr)))
(allow beamline_confined_service security_t (dir (getattr search read open)))
(allow beamline_confined_service security_t (file (getattr open read write map)))
(allow beamline_confined_service default_t (dir (getattr search)))
(allow beamline_confined_service default_t (lnk_file (getattr read)))
(allow beamline_confined_service unlabeled_t (dir (getattr search)))
(allow beamline_confined_service unlabeled_t (file (getattr open read)))
(allow beamline_confined_service unlabeled_t (lnk_file (getattr read)))
