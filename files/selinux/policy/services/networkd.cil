(type networkd_t)
(type networkd_exec_t)
(typeattributeset beamline_confined_service (networkd_t))
(typeattributeset beamline_confined_exec_type (networkd_exec_t))
(typeattributeset beamline_bus_service (networkd_t))
(filecon "/usr/bin/networkctl" file (system_u object_r networkd_exec_t lr_platform))
(typetransition init_t networkd_exec_t process networkd_t)
(allow networkd_t networkd_exec_t (file (entrypoint)))
(allow user_t networkd_exec_t (file (execute execute_no_trans)))

(allow networkd_t self (capability (net_admin net_bind_service net_raw)))
                                                                                              
                                                                                 
(allow networkd_t self (netlink_route_socket (create bind getattr setopt getopt read write nlmsg_read nlmsg_write)))
(allow networkd_t self (netlink_generic_socket (create bind getattr setopt getopt read write)))
(allow networkd_t self (netlink_netfilter_socket (create)))
(allow networkd_t self (netlink_kobject_uevent_socket (create bind getattr setopt getopt read)))
(allow networkd_t self (udp_socket (create bind connect getattr getopt setopt read write ioctl)))
(allow networkd_t self (packet_socket (create bind getattr setopt getopt read write)))
(allow networkd_t self (rawip_socket (create bind getattr setopt getopt read write)))
(allow networkd_t node_t (udp_socket (node_bind)))
(allow networkd_t port_t (udp_socket (name_bind)))
                                                                                                    
                                                                                           
(allow networkd_t self (capability2 (bpf)))
(allow networkd_t self (bpf (prog_load prog_run)))
(dontaudit networkd_t self (capability (sys_admin)))
(allow networkd_t tmpfs_t (file (getattr read write)))
                           
(allow networkd_t proc_sys_net_t (dir (getattr search)))
(allow networkd_t proc_sys_net_t (file (getattr open read write)))
                                      
(allow networkd_t nsfs_t (file (getattr open read)))
(allow networkd_t init_t (dir (getattr search)))
                                                                                                      
(allow networkd_t run_t (dir (getattr search read open write add_name remove_name create watch)))
(allow networkd_t run_t (file (getattr open read write create rename unlink setattr)))
(allow networkd_t run_t (sock_file (getattr create setattr unlink watch)))
(allow networkd_t root_t (dir (watch)))
(allow networkd_t var_lib_t (dir (getattr search read open)))
                                                                        
(dontaudit networkd_t kernel_t (system (module_request)))
