(type polkitd_t)
(type polkitd_exec_t)
(typeattributeset beamline_confined_service (polkitd_t))
(typeattributeset beamline_confined_exec_type (polkitd_exec_t))
(filecon "/usr/lib/polkit-1/polkitd" file (system_u object_r polkitd_exec_t lr_platform))
(typetransition init_t polkitd_exec_t process polkitd_t)
(allow polkitd_t polkitd_exec_t (file (entrypoint)))
(typeattributeset beamline_bus_service (polkitd_t))

                                                                                              
(allow polkitd_t beamline_domain (dir (getattr search)))
(allow polkitd_t beamline_domain (file (getattr open read ioctl)))
(allow polkitd_t beamline_domain (lnk_file (getattr read)))
                                                                                          
(allow polkitd_t run_t (dir (read open watch)))
(allow polkitd_t run_t (file (getattr open read)))
                                                                                            
                                              
(allow polkitd_t init_t (system (status)))
(allow polkitd_t beamline_any_type (service (status)))
