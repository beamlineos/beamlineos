# SPDX-License-Identifier: MIT
#
# arm64-specific settings shared by every profile kernel.

# No AArch32 userspace. FDSDK's LLVM is also built without the 32-bit ARM target, so
# clang could not build the compat vDSO anyway.
# CONFIG_COMPAT is not set

# Firmware interfaces of UEFI arm64 machines (QEMU virt with edk2 boots via ACPI)
CONFIG_ACPI=y

# PCI host bridge (ECAM), the PL011 serial console and PL031 RTC of QEMU virt
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
# The RTC through UEFI's runtime services. Booted through ACPI, QEMU virt (and UTM) describe no
# PL031, so without this there is no rtc0 and RTC_HCTOSYS has nothing to read (0.0.4.1 K3).
CONFIG_RTC_DRV_EFI=y

# arm64 hardening that allnoconfig would otherwise switch off
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_E0PD=y
CONFIG_UNMAP_KERNEL_AT_EL0=y

# AES-XTS with the ARMv8 Crypto Extensions, for homed's dm-crypt (docs/decisions.md D54)
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
