# SPDX-License-Identifier: MIT
#
# Security modules, shared by every profile kernel (docs/security.md §19.3). Built from
# allnoconfig, the Virt kernel has only what is listed here.

# LSM framework and audit (AVC denials are audit records)
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_AUDIT=y

# SELinux: the mandatory integrity foundation. DEVELOP is required for the development
# UKI's enforcing=0; BOOTPARAM stays off, so selinux=0 is ignored (security §19.3).
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
# CONFIG_SECURITY_SELINUX_BOOTPARAM is not set

# Unprivileged self-sandboxing (security §8.5) and ptrace scoping
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y

# IPE (docs/decisions.md D102): a boot policy compiled into the kernel for kernel-read operations
# (modules, firmware, kexec, policies, certificates), which load only from the initramfs or from
# a dm-verity volume with a verified root hash signature. The policy is staged into the kernel
# tree by the profile kernel element.
CONFIG_SECURITY_IPE=y
CONFIG_IPE_PROP_DM_VERITY=y
CONFIG_IPE_PROP_DM_VERITY_SIGNATURE=y
CONFIG_IPE_BOOT_POLICY="certs/boot.pol"

# Lockdown (the owner, 2026-10-14; docs/decisions.md D111), in every profile: no interface lets
# even root change the running kernel (/dev/mem, unsigned kexec, hibernation images, ACPI
# overrides, BPF writes to user memory), so Secure Boot's chain from the firmware reaches the
# running kernel. Integrity mode, forced at build time: the confidentiality mode also stops BPF
# programs reading kernel memory, which systemd's BPF programs do; mainline has no automatic
# lockdown under Secure Boot. Hibernation is therefore unavailable.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y

# Order of the enabled modules
CONFIG_LSM="lockdown,landlock,yama,selinux,ipe"

# Labels on the read-only root
CONFIG_EROFS_FS_SECURITY=y

# Module signing (docs/security.md §19.4): every module must carry a valid signature. The
# key is the committed development key, staged into the kernel tree by the profile kernel
# element, so no key is generated at build time and the build stays reproducible.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_MODULE_SIG_KEY="certs/module-signing.pem"

# Extension images' verity signatures are checked by the kernel (docs/decisions.md D53): the
# development verity certificate joins the built-in trusted keyring, staged into the kernel
# tree by the profile kernel element.
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_SYSTEM_TRUSTED_KEYS="certs/verity.crt"
