# SPDX-License-Identifier: MIT
#
# Shared by every profile kernel. The Virt kernel applies this on top of allnoconfig,
# the Hardware kernel on top of the architecture defconfig (docs/spec.md §11.3-11.5).
# Anything listed here is verified to survive configuration.

# Release string is <version><profile LOCALVERSION>, never a git-derived suffix
# CONFIG_LOCALVERSION_AUTO is not set

# Core
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_MULTIUSER=y
CONFIG_KALLSYMS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Hardening that allnoconfig would otherwise switch off
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# systemd requirements and recommendations (systemd README)
CONFIG_DEVTMPFS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_FHANDLE=y
CONFIG_FUTEX=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_PSI=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
# allnoconfig turns these off too; Flatpak's bubblewrap (--unshare-all) and systemd's
# service sandboxing (PrivateNetwork=, ProtectHostname=, ...) need them.
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y
CONFIG_KEYS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Networking (networkd, resolved, DHCP over raw packet sockets)
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y

# Boot: UEFI, UKI, systemd initrd
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y

# systemd credentials from the hypervisor (SMBIOS type 11)
CONFIG_DMI=y
CONFIG_DMI_SYSFS=y
# /sys/class/dmi/id: the machine's vendor and model for hostnamed, udev's hwdb and system
# monitors (0.0.4.1 K20, D84)
CONFIG_DMIID=y

# Block layer and partitions; loop devices attach extension images (docs/spec.md §8)
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_LOOP=y
# systemd-repart fills a partition it has just formatted by mounting it while it still holds the
# device open for writing, which is how systemd-sysinstall drives it (0.0.4.3 step 3, D110).
# Without this, the kernel's default, that mount fails with EBUSY.
CONFIG_BLK_DEV_WRITE_MOUNTED=y

# Filesystems: ESP, bring-up root, future immutable root and verity, sysext overlays
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y

# Character devices and clocks
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_HW_RANDOM=y
# A TPM 2.0 (0.0.4.3 step 1, docs/decisions.md D106): systemd-sysinstall seals the installed
# system's credentials with it, and systemd-stub and systemd measure the boot into it. QEMU's TPM
# (tpm-tis-device on arm64, through ACPI; tpm-tis on x86) uses the TIS FIFO interface; firmware
# TPMs on hardware often use CRB. Its random number generator feeds the kernel's pool.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM_TPM=y
CONFIG_RTC_CLASS=y
# Set the system clock from the RTC at boot, before userspace; without it the clock starts at
# systemd's build epoch until NTP synchronises (0.0.4.1 K3, D84)
CONFIG_RTC_HCTOSYS=y

# systemd-homed home areas (docs/spec.md §18.3, docs/decisions.md D54): LUKS2 images on DATA,
# opened with dm-crypt (AES-XTS), holding btrfs. cryptsetup encrypts the keyslot areas through
# the kernel's user-space crypto API.
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
