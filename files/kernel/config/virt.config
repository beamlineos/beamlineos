# SPDX-License-Identifier: MIT
#
# Virt profile: the virtual hardware contract (docs/spec.md §4) built in so the boot path
# never depends on module loading. Applied on top of allnoconfig (§11.4), so the menus
# that default to "y" are requested explicitly.

CONFIG_LOCALVERSION="-beamline-virt"

CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_INPUT=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_FW_CFG_SYSFS=y

# Graphical session (desktop-gnome, docs/spec.md §3.2, §30): virtio-gpu KMS and evdev for
# Mutter on a logind seat (no VTs, no framebuffer console), virtio-sound for PipeWire,
# fanotify for LocalSearch. virtio-input and FUSE (GVfs, the document portal) are above.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_SYNC_FILE=y
CONFIG_INPUT_EVDEV=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y
CONFIG_FANOTIFY=y
