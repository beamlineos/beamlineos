#!/bin/sh
# SPDX-License-Identifier: MIT
# Publish saved, green artifacts; never build an image or move a channel pointer.
# shellcheck source=ci/lib.sh
. "$(dirname "$0")/lib.sh"
cd "$REPO"
if is_macos; then
    PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
    export PATH
fi
exec python3 tools/publish.py "$@"
