#!/bin/sh
# SPDX-License-Identifier: MIT











# shellcheck source=ci/lib.sh
. "$(dirname "$0")/lib.sh"

image="${1:-$OUT/installed/reference.qcow2}"
[ -f "$image" ] || die "$image not found; run ./ci/test-install first"
log "security: the negative tests, enforcing"
python3 "$REPO/tools/qemu-test.py" --arch "$ARCH" --image "$image" \
    --credential-file "beamline.test.security-script=$REPO/tests/vm/security-check.sh" \
    --credential-file "beamline.test.transient-edges=$REPO/tests/vm/transient-edges.sh" \
    --extra-unit "$REPO/tests/vm/beamline-security-check.service" \
    --wants beamline-security-check.service \
    --kernel-arg systemd.mask=systemd-sysext.service \
    --kernel-arg systemd.mask=beamline-extension@desktop-gnome.service \
    --serial-script "$REPO/tests/vm/transient.script" \
    --require BEAMLINE_SELINUX_OK --require TRANSIENT_UID=0 --expect BEAMLINE_TRANSIENT_BOUND_OK \
    --require 'SECURITY verified-cli-domain: ok' \
    --require 'SECURITY mls-levels: ok' --require 'SECURITY init-alone: ok' \
    --require 'SECURITY system-roothash-signed: ok' \
    --require 'SECURITY ipe-data-module: ok' --require 'SECURITY ipe-system-module: ok' \
    --require 'SECURITY ipe-boot-policy: ok' \
    --require 'SECURITY mls-p0-writes-run: ok' --require 'SECURITY mls-admin-writes-run: ok' \
    --require 'SECURITY mls-p0-writes-p3-tmp: ok' --require 'SECURITY unit-linked-refused: ok' \
    --require 'SECURITY platform-writes-unit: ok' --require 'SECURITY admin-writes-unit: ok' \
    --require 'SECURITY generator-units-load: ok' \
    --require 'SECURITY domain-systemd-journald: ok' --require 'SECURITY domain-systemd-udevd: ok' \
    --require 'SECURITY domain-dbus-broker: ok' --require 'SECURITY domain-polkit: ok' \
    --require 'SECURITY domain-systemd-logind: ok' --require 'SECURITY domain-systemd-networkd: ok' \
    --require 'SECURITY domain-systemd-resolved: ok' --require 'SECURITY domain-avahi-daemon: ok' \
    --fail-on BEAMLINE_SECURITY_FAILED --timeout 600 \
    --log "$OUT/serial-security.log"



python3 "$REPO/tools/check-transition-audits.py" "$OUT/serial-security.log"
