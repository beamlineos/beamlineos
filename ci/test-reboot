#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Reboot test on the checked-out Virt image (docs/spec.md §14, docs/decisions.md D56): the
# first boot commits its machine ID into /etc's mutable layer on DATA and reboots; the second
# boot, whose initrd merges that layer, must come up with the same ID, so the previous boot is
# in this machine's journal. Extensions are not merged, as
# in ci/boot. The image itself is never modified.
#   ./ci/test-reboot [path/to/installed.qcow2]

# shellcheck source=ci/lib.sh
. "$(dirname "$0")/lib.sh"

image="${1:-$OUT/installed/reference.qcow2}"
[ -f "$image" ] || die "$image not found; run ./ci/test-install first"
log "reboot: stable machine ID"
python3 "$REPO/tools/qemu-test.py" --arch "$ARCH" --image "$image" --reboot \
    --extra-unit "$REPO/tests/vm/beamline-reboot-once.service" \
    --extra-unit "$REPO/tests/vm/beamline-previous-boot.service" \
    --wants beamline-reboot-once.service --wants beamline-previous-boot.service \
    --kernel-arg systemd.mask=systemd-sysext.service \
    --kernel-arg systemd.mask=beamline-extension@desktop-gnome.service \
    --require BEAMLINE_BOOT_OK --expect BEAMLINE_PREVIOUS_BOOT_OK \
    --log "$OUT/serial-reboot.log"
