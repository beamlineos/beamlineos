#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Escalation test on the checked-out Virt image (docs/spec.md §18.1, §19; docs/security.md
# §9.4; docs/decisions.md D55), scripted on the serial console (tests/vm/run0.script): dev
# (wheel) runs a command through run0 after polkit asks for dev's password, and it runs as
# root in admin_t; run0 without a command opens dev's shell as root, also in admin_t; alice is
# refused; a root console login fails. Extensions are not merged, as in ci/boot. The image itself is never
# modified.
#   ./ci/test-run0 [path/to/installed.qcow2]

# shellcheck source=ci/lib.sh
. "$(dirname "$0")/lib.sh"

image="${1:-$OUT/installed/reference.qcow2}"
[ -f "$image" ] || die "$image not found; run ./ci/test-install first"
log "run0: wheel escalates into admin_t, others are refused, root cannot log in"
python3 "$REPO/tools/qemu-test.py" --arch "$ARCH" --image "$image" \
    --serial-script "$REPO/tests/vm/run0.script" \
    --kernel-arg systemd.mask=systemd-sysext.service \
    --kernel-arg systemd.mask=beamline-extension@desktop-gnome.service \
    --require 'RUN0_CONTEXT=admin_u:admin_r:admin_t' --require 'RUN0_UID=0' \
    --require 'RUN0_SHELL_CONTEXT=admin_u:admin_r:admin_t' --require 'Access denied' --require 'PK_DENIED=[0-9]' \
    --expect 'Login incorrect' --timeout 420 \
    --log "$OUT/serial-run0.log"
