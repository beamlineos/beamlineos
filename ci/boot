#!/bin/sh
# SPDX-License-Identifier: MIT

















# shellcheck source=ci/lib.sh
. "$(dirname "$0")/lib.sh"

image="${1:-$OUT/installed/reference.qcow2}"
[ -f "$image" ] || die "$image not found; run ./ci/test-install first"
tpm="$(mktemp -d "${TMPDIR:-/tmp}/beamline-tpm.XXXXXX")"
trap 'rm -rf "$tpm"' EXIT INT TERM
[ ! -d "$(dirname "$image")/tpm" ] || cp -R "$(dirname "$image")/tpm/." "$tpm/"


python3 "$REPO/tools/qemu-test.py" --arch "$ARCH" --image "$image" --tpm "$tpm" --reboot \
    --extra-unit "$REPO/tests/vm/beamline-tpm-check.service" \
    --wants beamline-tpm-check.service \
    --extra-unit "$REPO/tests/vm/beamline-selinux-mode.service" \
    --wants beamline-selinux-mode.service \
    --extra-unit "$REPO/tests/vm/beamline-machine-identity.service" \
    --wants beamline-machine-identity.service \
    --extra-unit "$REPO/tests/vm/beamline-lockdown-check.service" \
    --wants beamline-lockdown-check.service \
    --kernel-arg systemd.mask=systemd-sysext.service \
    --kernel-arg systemd.mask=beamline-extension@desktop-gnome.service \
    --require BEAMLINE_SELINUX_OK --require 'BEAMLINE_SELINUX_ENFORCE=1' \
    --require 'setting system clock to [0-9]{4}-' --require 'BEAMLINE_DMI_VENDOR=QEMU' \
    --require BEAMLINE_TPM_OK --require 'BEAMLINE_LOCKDOWN none \[integrity\] confidentiality' \
    --fail-on 'bpf-lsm not supported' \
    --log "$OUT/serial.log"
