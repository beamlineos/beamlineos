#!/bin/sh
# SPDX-License-Identifier: MIT
# ExecStartPost readiness check; exits when the FUSE file has its signed size.
set -eu
[ "$#" -eq 2 ] || exit 2
image_path=$1
image_size=$2
case "$image_size" in ''|*[!0-9]*) exit 2 ;; esac
image_attempt=0
while [ "$image_attempt" -lt 30 ]; do
    if mountpoint -q "$(dirname "$image_path")"; then
        [ "$(stat -c %s "$image_path")" = "$image_size" ] || exit 1
        exit 0
    fi
    image_attempt=$((image_attempt + 1))
    sleep 1
done
echo "desync mount did not become ready: $image_path" >&2
exit 1
