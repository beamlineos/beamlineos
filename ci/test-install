#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Installation test (0.0.4.3, docs/decisions.md D106, D110–D113), and the installed disk every other
# VM test boots (there is no disk image; ci/test-vms runs this first).
# 1. Test firmware is provisioned as a PC is sold: Microsoft's keys, ours only as PK and KEK.
# 2. The medium boots: Debian's shim refuses systemd-boot and starts MokManager, which enrolls
#    beamline.der (tests/vm/mok-enroll.script); systemd-boot then starts the installer, whose
#    prompts the test answers (tests/vm/install.script) until it reboots, enforcing.
# 3. In parallel, each from the installed disk with copies of its UEFI variables and TPM:
#    - its first boot under Secure Boot: homed's prompt for the first account
#      (tests/vm/firstboot.script), the extensions fetched from this snapshot's update channel,
#      served over HTTP on this host, the reboot, then the account's console login. The test checks
#      the layout, the boot entries, DATA, the ESP's shim chain, Secure Boot, lockdown, and that
#      SYSTEM carries no installation component;
#    - the firmware refusing the installed UKIs once one byte of them is changed;
#    - the reference disk, out/<arch>/virt/installed/reference.qcow2: first booted with the test
#      accounts' credentials and powered off after its second boot.
# The medium is never modified (§28).
#   ./ci/test-install [path/to/install.raw]

# shellcheck source=ci/lib.sh
. "$(dirname "$0")/lib.sh"
# shellcheck source=ci/lib-install.sh
. "$REPO/ci/lib-install.sh"

medium="${1:-$OUT/install/install.raw}"
[ -f "$medium" ] || die "$medium not found; run ./ci/image first"
[ -f "$OUT/firmware/provision.raw" ] || die "$OUT/firmware/provision.raw not found; run ./ci/image first"
# The production UKI the medium installs; the snapshot's update channel carries the same file.
for uki in "$OUT"/update/beamline_*.efi; do :; done
[ -f "$uki" ] || die "no production UKI in $OUT/update; run ./ci/image first"

installed="$OUT/installed"
rm -rf "$installed"
mkdir -p "$installed"
DIR_WORK="$(mktemp -d "${TMPDIR:-/tmp}/beamline-install.XXXXXX")"
server=
pids=
cleanup() {
    [ -z "$server" ] || kill "$server" 2>/dev/null || true
    for pid in $pids; do kill "$pid" 2>/dev/null || true; done
    rm -rf "$DIR_WORK"
}
trap cleanup EXIT INT TERM

log "install: test firmware with Microsoft's keys"
provision_vars "$installed/efivars.fd" "$OUT/serial-install-provision.log"

log "install: the medium, a blank disk: MokManager enrolls Beamline's key, sysinstall installs"
install_medium "$medium" "$installed" secure-boot "$OUT/serial-install.log"

serve_channel "$OUT/update"

# Each parallel run gets its own copy of the variables and the TPM; the reference keeps the originals.
for run in firstboot tampered; do
    cp "$installed/efivars.fd" "$DIR_WORK/$run.efivars.fd"
    cp -R "$installed/tpm" "$DIR_WORK/$run.tpm"
done

log "install: in parallel: the first boot, a tampered UKI, the reference disk"
python3 "$REPO/tools/qemu-test.py" --arch "$ARCH" --image "$installed/target.qcow2" --secure-boot \
    --vars "$DIR_WORK/firstboot.efivars.fd" --tpm "$DIR_WORK/firstboot.tpm" --reboot \
    --no-homes --gpu 2d --memory 4G \
    --credential-file "tmpfiles.extra=$DIR_WORK/tmpfiles.extra" \
    --serial-script "$REPO/tests/vm/firstboot.script" \
    --extra-unit "$REPO/tests/vm/beamline-firstboot-check.service" \
    --wants beamline-firstboot-check.service \
    --require 'userdbctl\[[0-9]+\]: owner +wheel' \
    --require 'BEAMLINE_EXTENSION desktop-gnome' --require 'BEAMLINE_EXTENSION posix\s*$' \
    --require 'BEAMLINE_EXTENSION posix-devel' --require 'BEAMLINE_EXTENSION printing-scanning' \
    --require BEAMLINE_DESKTOP_MERGED \
    --expect 'Replace USER with your account name' --timeout 420 \
    --fail-on 'Login timed out' --fail-on 'Login incorrect' \
    --extra-unit "$REPO/tests/vm/beamline-selinux-mode.service" \
    --wants beamline-selinux-mode.service \
    --extra-unit "$REPO/tests/vm/beamline-installed-check.service" \
    --wants beamline-installed-check.service \
    --extra-unit "$REPO/tests/vm/beamline-lockdown-check.service" \
    --wants beamline-lockdown-check.service \
    --require 'Secure Boot: enabled \(user\)' \
    --require 'BEAMLINE_LOCKDOWN none \[integrity\] confidentiality' \
    --require 'BEAMLINE_NO_INSTALLER' \
    --require 'BEAMLINE_ESP EFI/Beamline/shimaa64.efi' --require 'BEAMLINE_ESP EFI/Beamline/grubaa64.efi' \
    --require 'BEAMLINE_ESP EFI/BOOT/BOOTAA64.EFI' --require 'BEAMLINE_ESP EFI/BOOT/fbaa64.efi' \
    --require BEAMLINE_SELINUX_OK --require 'BEAMLINE_SELINUX_ENFORCE=1' \
    --require 'BEAMLINE_PART vda[0-9]+ esp 268435456' \
    --require 'BEAMLINE_PART vda[0-9]+ XBOOTLDR 1073741824' \
    --require 'BEAMLINE_PART vda[0-9]+ beamline_[^ ]+ 1073741824' \
    --require 'BEAMLINE_PART vda[0-9]+ beamline_[^ ]+ 67108864' \
    --require 'BEAMLINE_PART vda[0-9]+ _empty 1073741824' \
    --require 'BEAMLINE_PART vda[0-9]+ _empty 67108864' \
    --require 'BEAMLINE_PART vda[0-9]+ RECOVERY 1073741824' \
    --require 'BEAMLINE_PART vda[0-9]+ RECOVERY-VERITY 67108864' \
    --require 'BEAMLINE_PART vda[0-9]+ data [0-9]{10,}' \
    --require 'BEAMLINE_DATA ext4 ' \
    --log "$OUT/serial-installed.log" > "$DIR_WORK/firstboot.out" 2>&1 &
firstboot=$!
python3 "$REPO/tools/qemu-test.py" --arch "$ARCH" --image "$installed/target.qcow2" --secure-boot \
    --vars "$DIR_WORK/tampered.efivars.fd" --tpm "$DIR_WORK/tampered.tpm" --reboot \
    --tamper-file "XBOOTLDR:$uki" \
    --expect 'Error loading EFI binary .*beamline_[^ ]*\.efi: (Access denied|Security [Vv]iolation)' \
    --fail-on 'Booting Linux' \
    --timeout 180 \
    --log "$OUT/serial-install-tampered.log" > "$DIR_WORK/tampered.out" 2>&1 &
tampered=$!
prepare_reference "$installed" secure-boot "$OUT/serial-install-reference.log" \
    > "$DIR_WORK/reference.out" 2>&1 &
reference=$!
pids="$firstboot $tampered $reference"

failed=0
for run in firstboot tampered reference; do
    eval "pid=\$$run"
    if wait "$pid"; then
        log "install: $run passed"
    else
        log "install: $run FAILED"
        tail -5 "$DIR_WORK/$run.out" >&2
        failed=1
    fi
done
pids=
[ "$failed" = 0 ] || die "installation test failed"
