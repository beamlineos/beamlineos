#!/bin/sh
# SPDX-License-Identifier: MIT









# shellcheck source=ci/lib.sh
. "$(dirname "$0")/lib.sh"

disk="${1:-}"
if [ -z "$disk" ] || [ ! -f "$disk" ]; then
    die "usage: ci/daily-telemetry PATH/TO/MACHINE-DISK [report-name]"
fi
name="${2:-$(date -u +%Y%m%d.%H%M)}"
daily="$REPO/out/$ARCH/daily"
mkdir -p "$daily/reports"
clone="$daily/session-disk"
rm -f "$clone"
if is_macos; then
    cp -c "$disk" "$clone"
else
    cp --reflink=auto "$disk" "$clone"
fi
log "collecting telemetry from $disk"
in_builder python3 tools/daily-telemetry.py "$clone" "$daily/reports/$name"
log "report: $daily/reports/$name/summary.md"
