#!/bin/sh
# SPDX-License-Identifier: MIT












# shellcheck source=ci/lib.sh
. "$(dirname "$0")/lib.sh"

mode=
no_commit=
for arg in "$@"; do
    case "$arg" in
        --force) mode=--force ;;
        --frozen) mode=--frozen ;;
        --no-commit) no_commit=--no-commit ;;
        *) die "unknown argument: $arg" ;;
    esac
done

set +e
# shellcheck disable=SC2086 # optional flags expand to nothing
in_builder python3 tools/integrate.py --arch "$ARCH" resolve $mode
status=$?
set -e
case "$status" in
    0) ;;
    3) exit 0 ;;
    4) die "integration failed at resolve (see out/integrations/)" ;;
    *) die "resolve failed" ;;
esac


if in_builder "$REPO/ci/check" && "$REPO/ci/build" && "$REPO/ci/test-base" && "$REPO/ci/image" \
    && "$REPO/ci/test-vms"; then
    # shellcheck disable=SC2086
    in_builder python3 tools/integrate.py --arch "$ARCH" record --result green $no_commit
else
    in_builder python3 tools/integrate.py --arch "$ARCH" record --result failed
    exit 1
fi
