[Unit]
Description=Beamline desync image %i
Wants=network-online.target
After=network-online.target
Before=caddy.service
PartOf=beamline-images.target

[Service]
Type=exec
User=caddy
Group=caddy
EnvironmentFile=/srv/beamline-images/store.env
EnvironmentFile=/srv/beamline-images/images/%i.env
CacheDirectory=beamline-images
UMask=0022
ExecStartPre=/usr/bin/mkdir -p /var/cache/beamline-images/store
ExecStartPre=-/usr/bin/env /usr/bin/fusermount3 -u -z /srv/beamline-images/mounts/%i
ExecStartPre=/usr/bin/mkdir -p /srv/beamline-images/mounts/%i
ExecStart=/usr/local/bin/desync --config /srv/beamline-images/desync.json --digest sha512-256 mount-index -s ${STORE_URL} -c /var/cache/beamline-images/store /srv/beamline-images/indexes/%i.caibx /srv/beamline-images/mounts/%i
ExecStartPost=/usr/local/libexec/beamline-image-ready /srv/beamline-images/mounts/%i/%i ${IMAGE_SIZE}
ExecStop=/usr/bin/env /usr/bin/fusermount3 -u /srv/beamline-images/mounts/%i
ExecStopPost=-/usr/bin/env /usr/bin/fusermount3 -u -z /srv/beamline-images/mounts/%i
Restart=on-failure
RestartMode=direct
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=30
# Mount in the host namespace so the existing Caddy can see it. Do not add
# PrivateTmp/ProtectSystem/ProtectHome here: they create a private mount namespace.
# fusermount3 also needs its setuid helper; NoNewPrivileges must remain disabled.
# Ordinary mountpoints avoid PID 1 trying to repair ownership on a dead FUSE
# RuntimeDirectory. env enters the normal service domain before the FUSE helper
# on SELinux hosts; the helper itself still runs as the unprivileged Caddy user.
