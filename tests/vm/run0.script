expect [a-z0-9-]+ login:
send dev\n
expect Password:
send dev\n
expect \$ 
send run0 /usr/bin/sh -c 'read -r c < /proc/self/attr/current; echo "RUN0_CONTEXT=$c"; while read -r k v r; do [ "$k" = Uid: ] && echo "RUN0_UID=$v"; done < /proc/self/status'\n
expect Password:
send dev\n
expect RUN0_UID=0
expect \$ 


send run0 /usr/bin/sh -c 'systemctl restart systemd-timesyncd.service && hostnamectl hostname beamline-run0 && journalctl --boot --lines=1 --no-pager >/dev/null && echo "RUN0_ADMIN_HOSTNAME=$(hostnamectl hostname)"'\n
expect Password:
send dev\n
expect RUN0_ADMIN_HOSTNAME=beamline-run0
expect \$ 
send run0\n
expect Password:
send dev\n
expect # 
send read -r c < /proc/self/attr/current; echo "RUN0_SHELL_CONTEXT=$c"; exit\n
expect RUN0_SHELL_CONTEXT=admin_u:admin_r:admin_t
expect \$ 
send exit\n

expect [a-z0-9-]+ login:
send alice\n
expect Password:
send alice\n
expect \$ 
send run0 /usr/bin/sh -c 'echo RUN0_RAN_FOR_ALICE'\n
expect Access denied
expect \$ 
send pkcheck --action-id org.freedesktop.sysupdate1.update --process $$ && echo PK_ALLOWED || echo "PK_DENIED=$?"\n
expect PK_DENIED=[0-9]
expect \$ 
send exit\n

expect [a-z0-9-]+ login:
send root\n
expect Password:
send anything\n
