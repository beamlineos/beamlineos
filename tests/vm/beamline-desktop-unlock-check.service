[Unit]
Description=Check unlocking the GNOME session

[Service]
Type=oneshot
User=dev
SELinuxContext=user_u:user_r:user_t:s0:c0
ImportCredential=beamline.test.desktop.unlock
TimeoutStartSec=120
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/bin/gjs -m %d/beamline.test.desktop.unlock
