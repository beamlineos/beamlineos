[Unit]
Description=Check Flatpak's system helper for the GNOME session

[Service]
Type=oneshot
User=dev
SELinuxContext=user_u:user_r:user_t:s0:c0
Environment=XDG_RUNTIME_DIR=/run/user/60001
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/60001/bus
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/bin/systemd-run --user --wait --pipe --quiet /usr/bin/busctl call --system org.freedesktop.Flatpak.SystemHelper /org/freedesktop/Flatpak/SystemHelper org.freedesktop.Flatpak.SystemHelper EnsureRepo us 0 ""
ExecStart=/usr/bin/systemd-run --user --wait --pipe --quiet /usr/bin/busctl call --system org.freedesktop.Flatpak.SystemHelper /org/freedesktop/Flatpak/SystemHelper org.freedesktop.Flatpak.SystemHelper RunTriggers us 0 ""
ExecStart=/usr/bin/sh -c '[ -d /var/lib/flatpak/repo ]'
