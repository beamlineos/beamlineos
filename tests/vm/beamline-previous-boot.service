[Unit]
Description=Check the previous boot is in this machine's journal
ConditionPathExists=/var/lib/beamline-test/rebooted
After=beamline-boot-ok.service

[Service]
Type=oneshot
StandardOutput=journal+console
ExecStart=/usr/bin/systemd-id128 machine-id
ExecStart=/usr/bin/journalctl --boot=-1 --lines=1 --quiet --no-pager
ExecStart=/usr/bin/systemd-escape BEAMLINE_PREVIOUS_BOOT_OK
