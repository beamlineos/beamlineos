[Unit]
Description=Report TPM 2.0 support on the console
ConditionPathExists=!/etc/initrd-release
Before=beamline-boot-ok.service

[Service]
Type=oneshot
StandardOutput=journal+console
ExecStart=/usr/bin/sh -c 'set -e; [ -e /sys/class/tpm/tpm0 ]; systemd-creds has-tpm2; echo beamline | systemd-creds encrypt --with-key=tpm2 --name=beamline-tpm - /run/beamline-tpm.cred; v=$$(systemd-creds decrypt --name=beamline-tpm /run/beamline-tpm.cred -); [ "$$v" = beamline ]; echo BEAMLINE_TPM_OK'
