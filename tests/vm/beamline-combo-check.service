[Unit]
Description=Check the desktop combined with extensions
ConditionPathExists=!/etc/initrd-release
After=beamline-boot-ok.service systemd-homed-firstboot.service

[Service]
Type=oneshot
ImportCredential=beamline.test.combo
ImportCredential=beamline.test.combo-script
RuntimeDirectory=beamline-combo
StandardOutput=journal+console
TimeoutStartSec=900
ExecStart=/usr/bin/sh %d/beamline.test.combo-script
