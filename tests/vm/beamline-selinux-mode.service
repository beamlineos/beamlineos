[Unit]
Description=Report the SELinux mode on the console
ConditionPathExists=!/etc/initrd-release
After=beamline-selinux-ok.service
Before=beamline-boot-ok.service

[Service]
Type=oneshot
StandardOutput=journal+console
ExecStart=/usr/bin/sh -c 'read -r enforce < /sys/fs/selinux/enforce; echo "BEAMLINE_SELINUX_ENFORCE=$enforce"'
