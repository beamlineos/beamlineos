[Unit]
Description=Report the installed system's first boot on the console
ConditionPathExists=!/etc/initrd-release

ConditionFirstBoot=no
After=beamline-first-user.service beamline-extensions-fetch.service
Before=beamline-boot-ok.service

[Service]
Type=oneshot
StandardOutput=journal+console
ExecStart=/usr/bin/userdbctl users-in-group wheel --no-legend
ExecStart=/usr/bin/sh -c 'for n in desktop-gnome posix posix-devel printing-scanning; do [ -e "/var/lib/beamline/extensions/$${n}_%A.raw" ] && [ -e "/var/lib/beamline/confexts/$${n}_%A.raw" ] && echo "BEAMLINE_EXTENSION $$n"; done; [ -x /usr/bin/gnome-shell ] && echo BEAMLINE_DESKTOP_MERGED; echo BEAMLINE_FIRSTBOOT_CHECKED'
