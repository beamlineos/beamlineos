[Unit]
Description=Negative security tests
ConditionPathExists=!/etc/initrd-release
After=beamline-boot-ok.service systemd-homed-firstboot.service

[Service]
Type=oneshot
ImportCredential=beamline.test.security-script
ImportCredential=beamline.test.transient-edges
StandardOutput=journal+console
ExecStart=/usr/bin/sh %d/beamline.test.security-script
