# SPDX-License-Identifier: MIT
#
# VM test (ci/test-install, 0.0.4.3 step 3, docs/decisions.md D106, D113): on the system
# systemd-sysinstall installed, booted alone, report for the harness to check:
# - the target's partitions (label and size in bytes). Labels come from udev, which reads the
#   partition table: partitions the first boot's repart adds have no name in sysfs until the next
#   boot (D110);
# - the boot entries and Secure Boot state (D111);
# - the ESP's shim chain, and that SYSTEM carries no installation component (D113).
# Injected through a systemd.extra-unit credential; never part of an image, so it may use dash.

[Unit]
Description=Report the installed layout on the console
ConditionPathExists=!/etc/initrd-release
After=local-fs.target
Before=beamline-boot-ok.service

[Service]
Type=oneshot
StandardOutput=journal+console
ExecStart=/usr/bin/sh -c 'for d in /sys/class/block/vda[0-9]*; do n=$${d##*/}; read -r s < "$$d/size"; udevadm info --query=property --name="/dev/$$n" | { name=; while IFS== read -r k v; do [ "$$k" = ID_PART_ENTRY_NAME ] && name=$$v; done; echo "BEAMLINE_PART $$n $$name $$((s * 512))"; }; done'
ExecStart=/usr/bin/bootctl list --no-pager
ExecStart=-/usr/bin/bootctl status --no-pager
ExecStart=/usr/bin/sh -c 'while read -r l; do set -- $$l; [ "$$5" = /data ] || continue; while [ "$$1" != - ]; do shift; done; echo "BEAMLINE_DATA $$2 $$3"; done < /proc/self/mountinfo'
ExecStart=/usr/bin/sh -c 'for f in EFI/Beamline/shimaa64.efi EFI/Beamline/grubaa64.efi EFI/Beamline/mmaa64.efi EFI/Beamline/BOOTAA64.CSV EFI/BOOT/BOOTAA64.EFI EFI/BOOT/fbaa64.efi EFI/BOOT/mmaa64.efi beamline.der; do [ -f "/efi/$$f" ] && echo "BEAMLINE_ESP $$f"; done; true'
ExecStart=/usr/bin/sh -c '[ -e /usr/bin/systemd-sysinstall ] || [ -e /usr/lib/repart.sysinstall.d ] || [ -e /usr/lib/beamline/esp ] || echo BEAMLINE_NO_INSTALLER'
