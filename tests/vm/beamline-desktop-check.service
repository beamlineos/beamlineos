[Unit]
Description=Check the GNOME session

ConditionPathExists=/run/user/60001/bus

[Service]
Type=oneshot
ImportCredential=beamline.test.shell-extension.check

RemainAfterExit=yes
User=dev

RuntimeDirectory=beamline-desktop-check/exports/share/applications
Environment=XDG_RUNTIME_DIR=/run/user/60001
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/60001/bus
TimeoutStartSec=600
StandardOutput=journal+console
StandardError=journal+console

ExecCondition=/usr/bin/busctl --user status org.gnome.Shell
ExecStart=/usr/bin/systemctl --user is-active pipewire.service wireplumber.service
ExecStart=/usr/bin/busctl --user call org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop org.freedesktop.DBus.Peer Ping
ExecStart=/usr/bin/flatpak --version


ExecStart=/usr/bin/bwrap --unshare-all --unshare-user --disable-userns --assert-userns-disabled --ro-bind /usr /usr --symlink usr/lib /lib --symlink usr/bin /bin --proc /proc --dev /dev /usr/bin/sh -c exit



ExecStart=/usr/bin/sh -c 'for d in /sys/class/block/*; do n=$${d##*/}; case $$n in vd[a-z]) continue ;; loop[0-9]*) [ -e "$$d/loop/backing_file" ] || [ -e "$$d/partition" ] || continue ;; esac; v=$$(udevadm info --query=property --property=UDISKS_IGNORE --value "/dev/$$n"); [ "$$v" = 1 ] || { echo "BEAMLINE_UDISKS_VISIBLE $$n"; exit 1; }; done'



ExecStart=/usr/bin/sh -c 'read -r head < /usr/share/applications/mimeinfo.cache; [ "$$head" = "[MIME Cache]" ]'
ExecStart=/usr/bin/sh -c 'r=/run/beamline-desktop-check; a=$$r/exports/share/applications; printf "[Desktop Entry]\nType=Application\nName=Handler\nExec=/usr/bin/true\nMimeType=x-scheme-handler/https;\n" > "$$a/org.beamline.Handler.desktop"; sh /usr/share/flatpak/triggers/desktop-database.trigger "$$r"; while read -r l; do [ "$$l" = "x-scheme-handler/https=org.beamline.Handler.desktop;" ] && exit 0; done < "$$a/mimeinfo.cache"; echo BEAMLINE_MIME_UNHANDLED; exit 1'
ExecStart=/usr/bin/sh %d/beamline.test.shell-extension.check




ExecStart=+/usr/bin/systemctl start beamline-desktop-flatpak-check.service

ExecStart=+/usr/bin/systemctl start beamline-desktop-unlock-check.service
ExecStart=/usr/bin/systemd-escape BEAMLINE_DESKTOP_OK
