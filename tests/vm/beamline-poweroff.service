# SPDX-License-Identifier: MIT
#
# VM test (ci/test-install, docs/decisions.md D113): power the installed disk off cleanly once its
# second boot has finished, so the reference disk the other tests boot is consistent. The first
# boot fetches the extensions and reboots. Injected through a systemd.extra-unit credential; never
# part of an image.

[Unit]
Description=Power off after the reference disk's second boot
ConditionFirstBoot=no
After=beamline-boot-ok.service
SuccessAction=poweroff

[Service]
Type=oneshot
